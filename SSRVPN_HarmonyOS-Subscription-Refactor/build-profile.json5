{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        // SDK 基线：本机 SDK 为 HarmonyOS 6.1.1（API 24）；产物可向后兼容安装到 API 26 设备
        "compatibleSdkVersion": "6.1.1(24)",
        "targetSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default"]
        }
      ]
    }
  ]
}
